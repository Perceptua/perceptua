---
layout: default
pagination:
  data: collections.browse
  size: 1
  alias: view
permalink: "{{ view.path }}"
---

{% if view.order == "asc" %}{% assign orderPath = "older/" %}{% else %}{% assign orderPath = "" %}{% endif %}

<div class="content-container" id="published-container">
  <nav class="browse-controls">
    <details class="dropdown">
      <summary>{{ view.medium | default: "all" | capitalize }}<i class="fas fa-angle-down"></i></summary>
      <div class="dropdown-menu">
        <a href="/{{ orderPath }}"{% unless view.medium %} class="active" aria-current="page"{% endunless %}>All</a>
        {% for m in view.media %}
          <a href="/{{ m }}/{{ orderPath }}"{% if m == view.medium %} class="active" aria-current="page"{% endif %}>{{ m | capitalize }}</a>
        {% endfor %}
      </div>
    </details>

    <span>
      <span class="order">
        <a href="{{ view.base }}"{% unless view.order == "asc" %} class="active" aria-current="page"{% endunless %}>Newest</a>
        <a href="{{ view.base }}older/"{% if view.order == "asc" %} class="active" aria-current="page"{% endif %}>Oldest</a>
      </span>
      {% if view.surprise %}
        <a id="surprise" href="{{ view.surprise.url }}">Surprise</a>
      {% endif %}
    </span>
  </nav>

  <div class="content-grid">
    {% for post in view.posts %}
      <div class="content-card">
        <a href="{{ post.url }}">
          <p class="added right">{{ post.date | cardDate }}</p>
          <h3 class="title">{{ post.data.title }}</h3>
          <p class="medium info">{{ post.data.categories[0] }}</p>
        </a>
      </div>
    {% endfor %}
  </div>
</div>

<script src="/static/browse.js" defer></script>
